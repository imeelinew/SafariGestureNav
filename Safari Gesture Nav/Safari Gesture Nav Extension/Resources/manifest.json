{
  "manifest_version": 3,
  "name": "Safari Gesture Nav",
  "version": "1.0.0",
  "description": "Two-finger tap goes back, three-finger tap goes forward in the current Safari tab.",
  "permissions": [
    "nativeMessaging",
    "tabs"
  ],
  "background": {
    "scripts": [
      "background.js"
    ]
  },
  "icons": {
    "16": "images/icon-16.png",
    "32": "images/icon-32.png",
    "48": "images/icon-48.png",
    "96": "images/icon-96.png",
    "128": "images/icon-128.png",
    "256": "images/icon-256.png",
    "512": "images/icon-512.png"
  }
}
